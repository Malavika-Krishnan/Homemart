{
  "info": {
    "_postman_id": "homemart-api-collection-v1",
    "name": "HomeMart Backend API Collection",
    "description": "Complete Postman collection for all HomeMart endpoints including Auth, Profile, Family, Lists, Items, Notifications, and Offline Sync.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "User Registration",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Developer\",\n  \"email\": \"alice.dev@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "User Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice.dev@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "2. User Profile",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/profile",
              "host": ["{{baseUrl}}"],
              "path": ["users", "profile"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Family Management",
      "item": [
        {
          "name": "Create Family",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"HomeMart Family\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/families/create",
              "host": ["{{baseUrl}}"],
              "path": ["families", "create"]
            }
          }
        },
        {
          "name": "Get Family Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/families",
              "host": ["{{baseUrl}}"],
              "path": ["families"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Shopping Lists",
      "item": [
        {
          "name": "Create List",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Weekly Groceries\",\n  \"description\": \"Supermarket shopping list\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/lists",
              "host": ["{{baseUrl}}"],
              "path": ["lists"]
            }
          }
        },
        {
          "name": "Get Family Lists",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/lists",
              "host": ["{{baseUrl}}"],
              "path": ["lists"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Shopping Items",
      "item": [
        {
          "name": "Add Item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"listId\": \"LIST_ID_HERE\",\n  \"name\": \"Organic Bananas\",\n  \"category\": \"Produce\",\n  \"quantity\": 2,\n  \"priority\": \"HIGH\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/items",
              "host": ["{{baseUrl}}"],
              "path": ["items"]
            }
          }
        }
      ]
    },
    {
      "name": "6. Offline Sync",
      "item": [
        {
          "name": "Sync Offline Batch",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientTimestamp\": \"2026-07-28T20:30:00.000Z\",\n  \"operations\": [\n    {\n      \"action\": \"CREATE\",\n      \"entity\": \"item\",\n      \"clientItemId\": \"client-uuid-999\",\n      \"listId\": \"LIST_ID_HERE\",\n      \"clientTimestamp\": \"2026-07-28T20:25:00.000Z\",\n      \"data\": {\n        \"name\": \"Offline Apples\",\n        \"category\": \"Produce\",\n        \"quantity\": 5\n      }\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sync",
              "host": ["{{baseUrl}}"],
              "path": ["sync"]
            }
          }
        }
      ]
    }
  ]
}
