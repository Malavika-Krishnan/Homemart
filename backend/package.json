  "version": "1.0.0",
  "description": "Backend API service for HomeMart smart shopping list application",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest --runInBand --detectOpenHandles"
  },
  "keywords": [
